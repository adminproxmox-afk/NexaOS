#!/bin/sh
set -eu

case " $(cat /proc/cmdline) " in
    *" nexa.desktop=1 "*) ;;
    *) exit 0 ;;
esac
grep -q '^/dev/sda /home/user ext4 rw,' /proc/mounts || exit 0

# Use the i8042 keyboard and mouse irrespective of event-device numbering.
for node in /sys/class/input/event*; do
    case "$(cat "$node/device/name" 2>/dev/null || true)" in
        "AT Translated Set 2 keyboard") ln -sf "/dev/input/${node##*/}" /dev/nexa-keyboard ;;
        *"PS/2"*"Mouse") ln -sf "/dev/input/${node##*/}" /dev/nexa-mouse ;;
    esac
done

mkdir -p /var/log
auth_dir=$(mktemp -d /run/nexa-desktop.XXXXXX)
chmod 0755 "$auth_dir"
export XAUTHORITY="$auth_dir/authority"
trap 'rm -f "$XAUTHORITY"; rmdir "$auth_dir"' EXIT
umask 077
touch "$XAUTHORITY"
if xauth add :0 MIT-MAGIC-COOKIE-1 "$(mcookie)"; then
    chown user:user "$XAUTHORITY"
    umask 022
    xinit /usr/sbin/nexa-desktop-session -- /usr/bin/Xorg :0 vt1 -nolisten tcp \
        -auth "$XAUTHORITY" -logfile /var/log/Xorg.0.log > /var/log/nexa-desktop.log 2>&1 || true
fi
echo NEXA_X_STOPPED > /dev/ttyS0
